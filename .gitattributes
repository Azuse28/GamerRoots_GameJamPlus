# Normaliza finales de línea: en el repo siempre LF, sin importar Windows o Linux
* text=auto eol=lf

# Archivos de texto de Unity (YAML) - forzar LF para evitar diffs falsos
*.cs       text eol=lf diff=csharp
*.shader   text eol=lf
*.hlsl     text eol=lf
*.cginc    text eol=lf
*.json     text eol=lf
*.asmdef   text eol=lf
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.meta     text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.mask     text eol=lf
*.playable text eol=lf
*.spriteatlas text eol=lf
*.spriteatlasv2 text eol=lf
*.inputactions text eol=lf
*.uss      text eol=lf
*.uxml     text eol=lf

